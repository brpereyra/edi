{
  "name": "XML",
  "extensions": [".xml", ".svg", ".plist", ".xsd"],
  "rules": [
    {
      "scope": "comment",
      "pattern": "<!--[\\s\\S]*?-->"
    },
    {
      "scope": "string",
      "pattern": "\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'"
    },
    {
      "scope": "keyword",
      "pattern": "</?[a-zA-Z0-9_:-]+(\\s|>|/>)"
    },
    {
      "scope": "type",
      "pattern": "\\b[a-zA-Z0-9_:-]+(?=\\s*=)"
    },
    {
      "scope": "function",
      "pattern": "&[a-zA-Z0-9#]+;"
    }
  ]
}
